# ==========================================
# VARIABLES PÚBLICAS (Disponibles en el navegador)
# ==========================================
# URL de tu proyecto en Supabase (ej: https://xxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=tu_supabase_url_aqui

# Clave anónima pública de Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# ==========================================
# VARIABLES PRIVADAS (Solo disponibles en el servidor)
# ==========================================
# Service Role Key para operaciones que bypassean RLS en casos específicos
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Clave de la API de YouTube v3 (necesaria para obtener metadatos y duraciones)
YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# Secreto para firmar cookies/sesiones (en NextAuth / Auth helpers)
# Genera uno seguro con: openssl rand -base64 32
NEXTAUTH_SECRET=tu_nextauth_secret_aqui
